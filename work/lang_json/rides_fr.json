use"}, "3": {"e": "null", "d": "Une monture reproductrice met au monde plus de jeunes montures qu'une monture normale.", "n": "Reproductrice"}, "4": {"e": "null", "d": "Une monture sage évolue deux fois plus vite qu'une monture normale.", "n": "Sage"}, "5": {"e": "null", "d": "Une monture endurante devient plus rapidement endurante qu'une monture normale.", "n": "Endurante"}, "6": {"e": "null", "d": "Une monture amoureuse devient plus rapidement amoureuse qu'une monture normale.", "n": "Amoureuse"}, "7": {"e": "null", "d": "Une monture précoce devient plus rapidement mature qu'une monture normale.", "n": "Précoce"}, "8": {"e": "null", "d": "Une monture prédisposée génétique a plus de chance de transmettre ses caractères génétiques qu'une monture normale.", "n": "Prédisposée Génétique"}, "9": {"e": "null", "d": "Une monture caméléone fait varier son ramage selon le plumage de l'aventurier qui la chevauche.", "n": "Caméléone"}}, "FILE_END": true}