"RIA": {"1": {"e": "null", "d": "Een onvermoeibare mount heeft veel meer energie dan een normale mount en herstelt zijn energie een stuk sneller.", "n": "Onvermoeibaar"}, "2": {"e": "null", "d": "Een veel tillende mount kan makkelijk meer voorwerpen dragen dan een normale mount.", "n": "Veel tillend"}, "3": {"e": "null", "d": "Een reproductieve mount zal geboorte geven aan meer mounts dan een normale mount.", "n": "Reproductief"}, "4": {"e": "null", "d": "Een wijze mount evolueert twee keer zo snel als een normale mount.", "n": "Wijs"}, "5": {"e": "null", "d": "Een sterke mount heeft een hogere kans om sterker te zijn dan een normale mount.", "n": "Sterk"}, "6": {"e": "null", "d": "Een verliefde mount heeft een hogere kans om verliefd te raken dan een normale mount.", "n": "Verliefd"}, "7": {"e": "null", "d": "Een vroegrijpe mount zal sneller volwassen worden dan een normale mount.", "n": "Vroegrijp"}, "8": {"e": "null", "d": "Een genetisch bedreven mount heeft een grotere kans om zijn genetische karakteristieken door te geven dan een normale mount.", "n": "Genetisch Bedreven"}, "9": {"e": "null", "d": "Kameleon rijdieren kunnen hun kleur aanpassen om bij het uiterlijk van de rijder te passen.", "n": "Kameleon"}}, "FILE_END": true}